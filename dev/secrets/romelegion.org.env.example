# Example secrets file for local dev (and a reference for what ops needs
# to drop on the VPS at /srv/secrets/romelegion.org.env).
#
# Copy this to dev/secrets/romelegion.org.env (gitignored) and fill in
# values you're willing to use locally. For real Resend testing, generate
# a low-quota Resend API key dedicated to dev so production deliverability
# is unaffected.

# Resend API key — generate at https://resend.com/api-keys
# In production: ops creates this scoped to the romelegion.org sending domain.
RESEND_API_KEY=re_REPLACE_WITH_DEV_KEY

# The "From" address all form submissions are sent from.
# Should be a verified sender on the sending domain.
EMAIL_FROM=Post 5 Web <noreply@romelegion.org>
