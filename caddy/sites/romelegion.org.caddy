# Caddy site block for romelegion.org
#
# Lives on the VPS at /etc/caddy/sites/romelegion.org.caddy.
# Source of truth is this file in the romelegion repo; OPS deploys it
# following the convention in runbooks/hosting-pattern.md § "Caddy site blocks".
#
# Pattern: static site under /srv/www/romelegion.org/, PHP form endpoints
# routed to the shared websites tenant's PHP-FPM at 127.0.0.1:9000.
# Matches the pattern used by elgranjardindenver.com on the same box.

# Apex
romelegion.org {
    root * /srv/www/romelegion.org

    encode zstd gzip

    # ---- Security headers ----
    header {
        # HTTPS-only navigation for a year, all subdomains
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Disable MIME-sniffing
        X-Content-Type-Options "nosniff"
        # Click-jacking protection
        X-Frame-Options "SAMEORIGIN"
        # No FLoC opt-in
        Permissions-Policy "interest-cohort=()"
        # Modest referrer policy — share origin only on cross-site nav
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server fingerprint
        -Server
    }

    # ---- Long cache for static assets (fingerprinted by Hugo) ----
    @assets {
        path *.css *.js *.woff *.woff2 *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.ics
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # ---- Short cache for HTML / docs (so content updates land within minutes) ----
    @html path *.html /
    header @html Cache-Control "public, max-age=300, must-revalidate"

    # ---- 301 redirects from the old Legionsites URLs ----
    # Preserves inbound links from Facebook, flyers, search-engine indexes,
    # and the old site's deep links after cutover. Old URL inventory in
    # site-inventory.md. 301 (permanent) so search engines transfer ranking.
    redir /home              / permanent
    redir /post-information  /about/ permanent
    redir /post-location     /about/ permanent
    redir /post-officers     /about/ permanent
    redir /post-history      /about/history/ permanent
    redir /board-of-directors /about/ permanent
    redir /committees        /about/ permanent
    redir /post-updates      /events/ permanent
    redir /special-events    /events/ permanent
    redir /site/eventscalendar /events/ permanent
    redir /site/contactus    /contact/ permanent
    redir /newsletter        /about/ permanent
    redir /rental-information /rental/ permanent
    redir /site/resourcerentals /rental/ permanent
    redir /membership-requirements /membership/requirements/ permanent
    redir /why-join          /membership/why-join/ permanent
    redir /benefits          /membership/why-join/ permanent
    redir /site/application   /membership/apply/ permanent
    redir /auxiliary         /family/auxiliary/ permanent
    redir /auxiliary-bulletin /family/auxiliary/ permanent
    redir /sons-of-legion    /family/sons/ permanent
    redir /legion-riders     /family/riders/ permanent
    redir /site/photogallery /gallery/ permanent
    redir /oratorical        /membership/ permanent
    redir /flag-etiquette    /flag-etiquette/ permanent
    redir /national-headquarters https://www.legion.org/ permanent
    redir /state-headquarters https://georgialegion.org/ permanent
    redir /affiliated-websites / permanent

    # ---- Form endpoints: only allow POST to specific .php files ----
    # We intentionally do NOT enable .php execution anywhere except these
    # known endpoints; the static publish dir has no other PHP and shouldn't.
    @formContact path /_form/contact.php
    @formApplication path /_form/application.php
    handle @formContact {
        php_fastcgi 127.0.0.1:9000
    }
    handle @formApplication {
        php_fastcgi 127.0.0.1:9000
    }

    # Any other .php request (including probes for /wp-login.php etc.) → 404
    @otherPhp path *.php
    respond @otherPhp 404

    # ---- Static file serving ----
    try_files {path} {path}/ {path}.html
    file_server

    # ---- Error pages ----
    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }

    # ---- Access log ----
    log {
        output file /var/log/caddy/romelegion.org.access.log {
            roll_size 50mb
            roll_keep 5
        }
        format console
    }
}

# Apex-only — redirect www to bare hostname
www.romelegion.org {
    redir https://romelegion.org{uri} 308
}
